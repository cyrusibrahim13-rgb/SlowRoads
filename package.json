{
  "name": "slowroads-desktop",
  "version": "2.5.1",
  "description": "Slow Roads desktop app",
  "main": "src-tauri/src/main.rs",
  "author": "",
  "license": "MIT",
  "scripts": {
    "prepare:index": "node restore-index.js",
    "release:notes": "node scripts/generate-release-notes.js",
    "dev": "npm run prepare:index && tauri dev",
    "start": "npm run dev",
    "build": "npm run prepare:index && tauri build",
    "dist": "npm run build",
    "dist:mac": "rustup target add x86_64-apple-darwin && npm run prepare:index && tauri build --target universal-apple-darwin --bundles dmg",
    "dist:win": "npm run prepare:index && tauri build --bundles nsis"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
